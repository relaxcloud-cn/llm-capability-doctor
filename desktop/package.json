{
  "name": "agentcheck-desktop",
  "version": "0.4.0",
  "private": true,
  "main": "main.cjs",
  "description": "AgentCheck desktop interface with bundled Chromium",
  "scripts": {
    "start": "npm run prepare:ui && electron .",
    "package:mac": "npm run prepare:ui && electron-packager . AgentCheck --platform=darwin --arch=arm64 --out=out --overwrite --asar",
    "package:windows": "npm run prepare:ui && electron-packager . AgentCheck --platform=win32 --arch=x64 --out=out --overwrite --asar",
    "prepare:ui": "node ../scripts/build-desktop-ui.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "@electron/packager": "20.3.0"
  }
}
