{
  "name": "agentcheck-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "description": "AgentCheck desktop interface with bundled Chromium",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-packager . AgentCheck --platform=darwin --arch=arm64 --out=out --overwrite --asar",
    "package:windows": "electron-packager . AgentCheck --platform=win32 --arch=x64 --out=out --overwrite --asar"
  },
  "devDependencies": {"electron": "44.7.0", "@electron/packager": "20.3.0"}
}
