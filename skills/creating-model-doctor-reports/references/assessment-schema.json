{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-capability-doctor.assessment.v3",
  "title": "LLM Capability Doctor Binary Assessment",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "run",
    "overall",
    "categories",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "llm-capability-doctor.assessment.v3"
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["fileName", "size", "sha256"]
    },
    "run": {
      "type": "object"
    },
    "overall": {
      "type": "object",
      "required": ["verdict", "counts", "blockers"],
      "properties": {
        "verdict": {
          "enum": ["READY", "BLOCKED"]
        },
        "counts": {
          "type": "object",
          "required": ["PASS", "FAIL"],
          "properties": {
            "PASS": {"type": "integer", "minimum": 0},
            "FAIL": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "blockers": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "counts", "failures"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL"]},
          "counts": {
            "type": "object",
            "required": ["PASS", "FAIL"],
            "additionalProperties": false
          },
          "failures": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "testId",
          "category",
          "name",
          "gateLevel",
          "reviewedStatus",
          "confidence",
          "conclusion",
          "logic",
          "evidenceRefs",
          "evidenceExcerpts",
          "limitations",
          "retestInstructions",
          "requests"
        ],
        "properties": {
          "gateLevel": {
            "enum": ["critical", "important", "observation"]
          },
          "reviewedStatus": {
            "enum": ["PASS", "FAIL"]
          },
          "confidence": {
            "enum": ["high", "medium", "low"]
          }
        }
      }
    }
  }
}
