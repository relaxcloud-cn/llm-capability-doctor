{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-capability-doctor.assessment.v7",
  "title": "LLM Capability Doctor Evidence-Bound Assessment",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "run",
    "tokenTotals",
    "warnings",
    "summary",
    "capabilitySummary",
    "protocolConformance",
    "categories",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "llm-capability-doctor.assessment.v7"
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["fileName", "size", "sha256"],
      "properties": {
        "fileName": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object"
    },
    "tokenTotals": {
      "type": "object"
    },
    "warnings": {
      "type": "array"
    },
    "summary": {
      "type": "object",
      "required": ["counts"],
      "properties": {
        "counts": {
          "type": "object",
          "required": ["PASS", "FAIL"],
          "properties": {
            "PASS": {"type": "integer", "minimum": 0},
            "FAIL": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capabilitySummary": {
      "$ref": "#/$defs/capabilitySummary"
    },
    "protocolConformance": {
      "$ref": "#/$defs/protocolConformance"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "counts"],
        "properties": {
          "name": {"type": "string"},
          "counts": {
            "type": "object",
            "required": ["PASS", "FAIL"],
            "properties": {
              "PASS": {"type": "integer", "minimum": 0},
              "FAIL": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "testId",
          "category",
          "name",
          "reviewedStatus",
          "conclusion",
          "logic",
          "rawObservation",
          "metrics",
          "evidenceRefs",
          "evidenceExcerpts",
          "limitations",
          "retestInstructions",
          "requests"
        ],
        "properties": {
          "testId": {"type": "string", "pattern": "^[0-9]{3}$"},
          "category": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "reviewedStatus": {
            "enum": ["PASS", "FAIL"]
          },
          "conclusion": {"type": "string", "minLength": 1},
          "logic": {
            "type": "object",
            "required": [
              "purpose",
              "method",
              "passCriteria",
              "failCriteria",
              "capabilityBoundary"
            ],
            "properties": {
              "purpose": {"type": "string"},
              "method": {"type": "string"},
              "passCriteria": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1
              },
              "failCriteria": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1
              },
              "capabilityBoundary": {"type": "string"}
            },
            "additionalProperties": false
          },
          "rawObservation": {"type": "string", "minLength": 1},
          "metrics": {
            "type": "array",
            "items": {"type": "object"}
          },
          "evidenceRefs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "evidenceExcerpts": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "retestInstructions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "requests": {
            "type": "array",
            "items": {"type": "object"}
          },
          "failureAnalysis": {
            "$ref": "#/$defs/failureAnalysis"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reviewedStatus": {"const": "FAIL"}
              },
              "required": ["reviewedStatus"]
            },
            "then": {"required": ["failureAnalysis"]},
            "else": {"not": {"required": ["failureAnalysis"]}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "protocolConformance": {
      "type": "object",
      "required": [
        "ruleSetVersion",
        "baselineDate",
        "baselines",
        "summary",
        "results"
      ],
      "properties": {
        "ruleSetVersion": {
          "const": "official-protocol-conformance.2026-08-18"
        },
        "baselineDate": {
          "const": "2026-08-18"
        },
        "baselines": {
          "type": "array",
          "items": {"$ref": "#/$defs/protocolBaseline"},
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
        },
        "summary": {
          "$ref": "#/$defs/protocolConformanceSummary"
        },
        "results": {
          "type": "array",
          "items": {"$ref": "#/$defs/protocolConformanceResult"}
        }
      },
      "additionalProperties": false
    },
    "protocolBaseline": {
      "type": "object",
      "required": [
        "protocol",
        "officialVersion",
        "referenceDate",
        "sourceUrl",
        "supportingReferences"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "openai_chat",
            "openai_responses",
            "anthropic_messages",
            "gemini_generate_content",
            "ollama_chat"
          ]
        },
        "officialVersion": {"type": "string", "minLength": 1},
        "referenceDate": {"const": "2026-08-18"},
        "sourceUrl": {"type": "string", "minLength": 1},
        "supportingReferences": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "protocol",
                "officialVersion",
                "referenceDate",
                "sourceUrl",
                "supportingReferences"
              ],
              "properties": {
                "protocol": {"const": "openai_chat"},
                "officialVersion": {
                  "const": "OpenAPI 2.3.0, commit 2186421dca0cca7c1e67caa7739005e8b1ccc4dd"
                },
                "referenceDate": {"const": "2026-08-18"},
                "sourceUrl": {
                  "const": "https://github.com/openai/openai-openapi/blob/2186421dca0cca7c1e67caa7739005e8b1ccc4dd/openapi.json"
                },
                "supportingReferences": {
                  "const": [
                    "https://platform.openai.com/docs/api-reference/chat/object",
                    "https://platform.openai.com/docs/api-reference/chat/streaming",
                    "https://platform.openai.com/docs/guides/error-codes/api-errors"
                  ]
                }
              }
            },
            {
              "required": [
                "protocol",
                "officialVersion",
                "referenceDate",
                "sourceUrl",
                "supportingReferences"
              ],
              "properties": {
                "protocol": {"const": "openai_responses"},
                "officialVersion": {
                  "const": "OpenAPI 2.3.0, commit 2186421dca0cca7c1e67caa7739005e8b1ccc4dd"
                },
                "referenceDate": {"const": "2026-08-18"},
                "sourceUrl": {
                  "const": "https://github.com/openai/openai-openapi/blob/2186421dca0cca7c1e67caa7739005e8b1ccc4dd/openapi.json"
                },
                "supportingReferences": {
                  "const": [
                    "https://platform.openai.com/docs/api-reference/responses/object",
                    "https://platform.openai.com/docs/api-reference/responses-streaming",
                    "https://platform.openai.com/docs/guides/error-codes/api-errors"
                  ]
                }
              }
            },
            {
              "required": [
                "protocol",
                "officialVersion",
                "referenceDate",
                "sourceUrl",
                "supportingReferences"
              ],
              "properties": {
                "protocol": {"const": "anthropic_messages"},
                "officialVersion": {
                  "const": "anthropic-version: 2023-06-01"
                },
                "referenceDate": {"const": "2026-08-18"},
                "sourceUrl": {
                  "const": "https://platform.claude.com/docs/en/api/messages/create"
                },
                "supportingReferences": {
                  "const": [
                    "https://platform.claude.com/docs/en/api/messages-streaming",
                    "https://platform.claude.com/docs/en/api/errors"
                  ]
                }
              }
            },
            {
              "required": [
                "protocol",
                "officialVersion",
                "referenceDate",
                "sourceUrl",
                "supportingReferences"
              ],
              "properties": {
                "protocol": {"const": "gemini_generate_content"},
                "officialVersion": {
                  "const": "v1beta Discovery revision 20260816"
                },
                "referenceDate": {"const": "2026-08-18"},
                "sourceUrl": {
                  "const": "https://generativelanguage.googleapis.com/$discovery/rest?version=v1beta"
                },
                "supportingReferences": {
                  "const": [
                    "https://ai.google.dev/api/generate-content",
                    "https://ai.google.dev/api/rest/generativelanguage"
                  ]
                }
              }
            },
            {
              "required": [
                "protocol",
                "officialVersion",
                "referenceDate",
                "sourceUrl",
                "supportingReferences"
              ],
              "properties": {
                "protocol": {"const": "ollama_chat"},
                "officialVersion": {
                  "const": "OpenAPI commit d67ad83426633195089509347ffd4fe795120198"
                },
                "referenceDate": {"const": "2026-08-18"},
                "sourceUrl": {
                  "const": "https://github.com/ollama/ollama/blob/d67ad83426633195089509347ffd4fe795120198/docs/openapi.yaml"
                },
                "supportingReferences": {
                  "const": [
                    "https://docs.ollama.com/api/chat",
                    "https://docs.ollama.com/api/errors"
                  ]
                }
              }
            }
          ]
        }
      ],
      "additionalProperties": false
    },
    "protocolConformanceSummary": {
      "type": "object",
      "required": [
        "totalRequests",
        "checkedRequests",
        "consistentRequests",
        "differentRequests",
        "byProtocol",
        "byCheck",
        "byDifferenceKind"
      ],
      "properties": {
        "totalRequests": {"type": "integer", "minimum": 0},
        "checkedRequests": {"type": "integer", "minimum": 0},
        "consistentRequests": {"type": "integer", "minimum": 0},
        "differentRequests": {"type": "integer", "minimum": 0},
        "byProtocol": {
          "type": "array",
          "items": {"$ref": "#/$defs/protocolConformanceProtocolGroup"}
        },
        "byCheck": {
          "type": "array",
          "items": {"$ref": "#/$defs/protocolConformanceCheckGroup"}
        },
        "byDifferenceKind": {
          "type": "array",
          "items": {"$ref": "#/$defs/protocolConformanceDifferenceGroup"}
        }
      },
      "additionalProperties": false
    },
    "protocolConformanceProtocolGroup": {
      "type": "object",
      "required": [
        "protocol",
        "totalRequests",
        "consistentRequests",
        "differentRequests"
      ],
      "properties": {
        "protocol": {"type": "string", "minLength": 1},
        "totalRequests": {"type": "integer", "minimum": 0},
        "consistentRequests": {"type": "integer", "minimum": 0},
        "differentRequests": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "protocolConformanceCheckGroup": {
      "type": "object",
      "required": [
        "checkId",
        "totalRequests",
        "consistentRequests",
        "differentRequests"
      ],
      "properties": {
        "checkId": {"type": "string", "minLength": 1},
        "totalRequests": {"type": "integer", "minimum": 0},
        "consistentRequests": {"type": "integer", "minimum": 0},
        "differentRequests": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "protocolConformanceDifferenceGroup": {
      "type": "object",
      "required": ["differenceKind", "count"],
      "properties": {
        "differenceKind": {
          "$ref": "#/$defs/protocolDifferenceKind"
        },
        "count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "protocolConformanceResult": {
      "type": "object",
      "required": [
        "requestId",
        "protocol",
        "checkIds",
        "stream",
        "httpStatus",
        "status",
        "differences"
      ],
      "properties": {
        "requestId": {"type": "string", "minLength": 1},
        "protocol": {"type": ["string", "null"], "minLength": 1},
        "checkIds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "stream": {"type": "boolean"},
        "httpStatus": {"type": ["integer", "null"]},
        "status": {"enum": ["CONSISTENT", "DIFFERENT"]},
        "differences": {
          "type": "array",
          "items": {"$ref": "#/$defs/protocolDifference"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "CONSISTENT"}},
            "required": ["status"]
          },
          "then": {"properties": {"differences": {"maxItems": 0}}},
          "else": {"properties": {"differences": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "protocolDifference": {
      "type": "object",
      "required": [
        "requestId",
        "protocol",
        "location",
        "differenceKind",
        "expected",
        "actual",
        "officialReference"
      ],
      "properties": {
        "requestId": {"type": "string", "minLength": 1},
        "protocol": {"type": ["string", "null"], "minLength": 1},
        "location": {"type": "string", "pattern": "^/"},
        "differenceKind": {
          "enum": [
            "EVIDENCE_GAP",
            "FRAMING",
            "INVALID_JSON",
            "MISSING_FIELD",
            "UNEXPECTED_FIELD",
            "TYPE_MISMATCH",
            "ENUM_MISMATCH",
            "VALUE_MISMATCH",
            "SEQUENCE",
            "CORRELATION"
          ]
        },
        "expected": {"type": "string", "minLength": 1},
        "actual": {"type": "string", "minLength": 1},
        "officialReference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "protocolDifferenceKind": {
      "enum": [
        "EVIDENCE_GAP",
        "FRAMING",
        "INVALID_JSON",
        "MISSING_FIELD",
        "UNEXPECTED_FIELD",
        "TYPE_MISMATCH",
        "ENUM_MISMATCH",
        "VALUE_MISMATCH",
        "SEQUENCE",
        "CORRELATION"
      ]
    },
    "failureAnalysis": {
      "type": "object",
      "required": [
        "failureKind",
        "evidenceSufficiency",
        "supportedClaim",
        "unsupportedClaims",
        "dependsOnTestIds",
        "evidenceRefs"
      ],
      "properties": {
        "failureKind": {
          "enum": [
            "DIRECT",
            "CONTRACT_FACET",
            "MEASUREMENT_UNAVAILABLE",
            "EVIDENCE_GAP"
          ]
        },
        "evidenceSufficiency": {
          "enum": ["SUFFICIENT", "LIMITED", "INSUFFICIENT"]
        },
        "supportedClaim": {"type": "string", "minLength": 1},
        "unsupportedClaims": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "dependsOnTestIds": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{3}$"},
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capabilityIssue": {
      "type": "object",
      "required": [
        "title",
        "statement",
        "testRefs",
        "evidenceRefs",
        "boundary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z])(?:[Rr][Ee][Aa][Dd][Yy]|[Bb][Ll][Oo][Cc][Kk][Ee][Dd])(?![A-Za-z])|可上线|不可上线))[\\s\\S]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z])(?:[Rr][Ee][Aa][Dd][Yy]|[Bb][Ll][Oo][Cc][Kk][Ee][Dd])(?![A-Za-z])|可上线|不可上线))[\\s\\S]+$"
        },
        "testRefs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{3}$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "boundary": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z])(?:[Rr][Ee][Aa][Dd][Yy]|[Bb][Ll][Oo][Cc][Kk][Ee][Dd])(?![A-Za-z])|可上线|不可上线))[\\s\\S]+$"
        }
      },
      "additionalProperties": false
    },
    "generalVerdict": {
      "type": "object",
      "required": [
        "level",
        "label",
        "collectedTests",
        "passedTests",
        "totalTests",
        "passedCoreTests",
        "totalCoreTests",
        "passedEnhancedTests",
        "totalEnhancedTests",
        "statement"
      ],
      "properties": {
        "level": {
          "enum": ["PASS", "CONDITIONAL_PASS", "FAIL", "NOT_ASSESSED"]
        },
        "label": {
          "enum": [
            "通用能力通过",
            "通用能力有条件通过",
            "通用能力未通过",
            "通用能力未评定"
          ]
        },
        "collectedTests": {"type": "integer", "minimum": 0, "maximum": 46},
        "passedTests": {"type": "integer", "minimum": 0, "maximum": 46},
        "totalTests": {"const": 46},
        "passedCoreTests": {"type": "integer", "minimum": 0, "maximum": 31},
        "totalCoreTests": {"const": 31},
        "passedEnhancedTests": {"type": "integer", "minimum": 0, "maximum": 15},
        "totalEnhancedTests": {"const": 15},
        "statement": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "capabilitySummary": {
      "type": "object",
      "required": [
        "generalVerdict",
        "headline",
        "verifiedFacts",
        "issues",
        "scopeBoundary"
      ],
      "properties": {
        "generalVerdict": {
          "$ref": "#/$defs/generalVerdict"
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z])(?:[Rr][Ee][Aa][Dd][Yy]|[Bb][Ll][Oo][Cc][Kk][Ee][Dd])(?![A-Za-z])|可上线|不可上线))[\\s\\S]+$"
        },
        "verifiedFacts": {
          "$ref": "#/$defs/verifiedFacts"
        },
        "issues": {
          "type": "array",
          "items": {"$ref": "#/$defs/capabilityIssue"},
          "maxItems": 5
        },
        "scopeBoundary": {
          "const": "本节仅总结本轮可观察能力，不构成项目 READY/BLOCKED 判定。"
        }
      },
      "additionalProperties": false
    },
    "verifiedFacts": {
      "type": "object",
      "required": ["interfaceProtocol", "contextWindow", "concurrency"],
      "properties": {
        "interfaceProtocol": {
          "$ref": "#/$defs/interfaceProtocolFact"
        },
        "contextWindow": {
          "$ref": "#/$defs/contextWindowFact"
        },
        "concurrency": {
          "$ref": "#/$defs/concurrencyFact"
        }
      },
      "additionalProperties": false
    },
    "interfaceProtocolFact": {
      "type": "object",
      "required": [
        "evidenceState",
        "family",
        "requestFormat",
        "responseFormat",
        "statement",
        "evidenceRefs",
        "boundary"
      ],
      "properties": {
        "evidenceState": {
          "enum": ["VERIFIED", "INCONCLUSIVE", "NOT_COLLECTED"]
        },
        "family": {
          "enum": [
            "OPENAI_CHAT_COMPLETIONS",
            "OPENAI_RESPONSES",
            "ANTHROPIC_MESSAGES",
            "GEMINI_GENERATE_CONTENT",
            "OLLAMA_CHAT",
            "CUSTOM",
            "UNKNOWN"
          ]
        },
        "requestFormat": {"type": "string", "minLength": 1},
        "responseFormat": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidenceRefs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "contextWindowFact": {
      "type": "object",
      "required": [
        "evidenceState",
        "highestVerifiedTier",
        "highestVerifiedInputTokens",
        "firstFailedTier",
        "firstFailedInputTokens",
        "statement",
        "evidenceRefs",
        "boundary"
      ],
      "properties": {
        "evidenceState": {
          "enum": ["VERIFIED", "INCONCLUSIVE", "NOT_COLLECTED"]
        },
        "highestVerifiedTier": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "highestVerifiedInputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "firstFailedTier": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "firstFailedInputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "statement": {"type": "string", "minLength": 1},
        "evidenceRefs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "concurrencyFact": {
      "type": "object",
      "required": [
        "evidenceState",
        "highestVerifiedConcurrentRequests",
        "statement",
        "evidenceRefs",
        "boundary"
      ],
      "properties": {
        "evidenceState": {
          "enum": ["VERIFIED", "INCONCLUSIVE", "NOT_COLLECTED"]
        },
        "highestVerifiedConcurrentRequests": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "statement": {"type": "string", "minLength": 1},
        "evidenceRefs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
