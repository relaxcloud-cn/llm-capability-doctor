{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-capability-doctor.assessment.v4",
  "title": "LLM Capability Doctor Per-Test Binary Assessment",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "run",
    "tokenTotals",
    "warnings",
    "summary",
    "categories",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "llm-capability-doctor.assessment.v4"
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["fileName", "size", "sha256"],
      "properties": {
        "fileName": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object"
    },
    "tokenTotals": {
      "type": "object"
    },
    "warnings": {
      "type": "array"
    },
    "summary": {
      "type": "object",
      "required": ["counts"],
      "properties": {
        "counts": {
          "type": "object",
          "required": ["PASS", "FAIL"],
          "properties": {
            "PASS": {"type": "integer", "minimum": 0},
            "FAIL": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "counts"],
        "properties": {
          "name": {"type": "string"},
          "counts": {
            "type": "object",
            "required": ["PASS", "FAIL"],
            "properties": {
              "PASS": {"type": "integer", "minimum": 0},
              "FAIL": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "testId",
          "category",
          "name",
          "reviewedStatus",
          "conclusion",
          "logic",
          "rawObservation",
          "metrics",
          "evidenceRefs",
          "evidenceExcerpts",
          "limitations",
          "retestInstructions",
          "requests"
        ],
        "properties": {
          "testId": {"type": "string", "pattern": "^[0-9]{3}$"},
          "category": {"type": "string"},
          "name": {"type": "string"},
          "reviewedStatus": {
            "enum": ["PASS", "FAIL"]
          },
          "conclusion": {"type": "string"},
          "logic": {
            "type": "object",
            "required": [
              "purpose",
              "method",
              "passCriteria",
              "failCriteria",
              "capabilityBoundary"
            ],
            "properties": {
              "purpose": {"type": "string"},
              "method": {"type": "string"},
              "passCriteria": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1
              },
              "failCriteria": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1
              },
              "capabilityBoundary": {"type": "string"}
            },
            "additionalProperties": false
          },
          "rawObservation": {"type": "string"},
          "metrics": {
            "type": "array",
            "items": {"type": "object"}
          },
          "evidenceRefs": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "evidenceExcerpts": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {"type": "string"}
          },
          "retestInstructions": {
            "type": "array",
            "items": {"type": "string"}
          },
          "requests": {
            "type": "array",
            "items": {"type": "object"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
