{
  "name": "llm-capability-doctor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write package.json tsconfig.json src",
    "format:check": "prettier --check package.json tsconfig.json src"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
